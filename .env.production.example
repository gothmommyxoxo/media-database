# Infrastructure settings for docker-compose.prod.yml. Copy to .env (repo root) and fill in.
# App/provider secrets (JWT_SECRET, API keys) live separately in backend/.env.
# Never commit .env.

# Public hostname. Its DNS A/AAAA record must point at this server, and ports 80 + 443 must be
# reachable from the internet, for Caddy to obtain a Let's Encrypt certificate.
DOMAIN=media.example.com

# Generate each with: openssl rand -hex 24
# (hex keeps them URL-safe — MYSQL_PASSWORD is embedded in the backend's DATABASE_URL)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Where daily mysqldumps are written on the host, and how many days to keep.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
