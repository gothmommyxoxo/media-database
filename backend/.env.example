# Copy this file to .env and fill in real values. Never commit .env itself.
# See specs/media-database-frontend.nlspec.md Section 11.2 for the full reference.

# In production (docker-compose.prod.yml) DATABASE_URL and ENVIRONMENT=production are set by the
# compose file; the backend then refuses to start unless JWT_SECRET is a real random value of at
# least 32 characters. Generate one with: openssl rand -hex 32
DATABASE_URL=mysql+pymysql://media_database:media_database@db:3306/media_database
JWT_SECRET=change-me-to-a-long-random-value

# Books / manga / graphic novels (Appendix A.3)
GOOGLE_BOOKS_API_KEY=

# Movies / video releases: BLU_RAY, DVD, VHS, VCD (Appendix A.2)
TMDB_API_KEY=
OMDB_API_KEY=

# Video games (Appendix A.4)
SCANDEX_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=
PRICECHARTING_API_KEY=

# Music: CD, VINYL, CASSETTE (Appendix A.5)
DISCOGS_TOKEN=

# Comic books (Appendix A.7)
COMICVINE_API_KEY=

# General UPC/EAN lookup (Appendix A.1)
UPCITEMDB_MODE=trial
BARCODESPIDER_API_KEY=

CACHE_TTL_DAYS=30
